+// OpenStacks: BlueStacks' guest (goldfish-opengl-pie fork) sends opcode 2488
+// glGetProgramStateInfoCustom(program) after every successful glLinkProgram and
+// fills its GLSharedGroup from the reply instead of glGetActiveUniform loops:
+//   u32 L, then L bytes: {nU, uMaxLen, nA, aMaxLen, x10, x14} +
+//   nU records of (uMaxLen + 20) bytes + nA records of (aMaxLen + 20) bytes,
+//   record = {u32 nameLen, u32 size, u32 type, u32 location, char name[maxLen + 4]}.
+// x10 lands in the guest's uniform block count, x14 next to it; the guest never
+// reads either locally, so they stay 0 (querying blocks would raise a GL error
+// on GLES2 contexts).
+void ostProgramStateInfo(gles2_decoder_context_t* ctx, GLuint program,
+                         std::vector<unsigned char>* out) {
+    GLint nU = 0, uMax = 0, nA = 0, aMax = 0;
+    ctx->glGetProgramiv_dec(ctx, program, 0x8B86 /* GL_ACTIVE_UNIFORMS */, &nU);
+    ctx->glGetProgramiv_dec(ctx, program, 0x8B87 /* GL_ACTIVE_UNIFORM_MAX_LENGTH */, &uMax);
+    ctx->glGetProgramiv_dec(ctx, program, 0x8B89 /* GL_ACTIVE_ATTRIBUTES */, &nA);
+    ctx->glGetProgramiv_dec(ctx, program, 0x8B8A /* GL_ACTIVE_ATTRIBUTE_MAX_LENGTH */, &aMax);
+    if (nU < 0) nU = 0;
+    if (nA < 0) nA = 0;
+    if (uMax < 0) uMax = 0;
+    if (aMax < 0) aMax = 0;
+    const size_t uRec = (size_t)uMax + 20, aRec = (size_t)aMax + 20;
+    out->assign(24 + (size_t)nU * uRec + (size_t)nA * aRec, 0);
+    uint32_t hdr[6] = {(uint32_t)nU, (uint32_t)uMax, (uint32_t)nA, (uint32_t)aMax, 0, 0};
+    memcpy(out->data(), hdr, sizeof(hdr));
+    unsigned char* rec = out->data() + 24;
+    for (GLint i = 0; i < nU; i++, rec += uRec) {
+        GLsizei len = 0;
+        GLint size = 0;
+        GLenum type = 0;
+        GLchar* name = (GLchar*)(rec + 16);
+        ctx->glGetActiveUniform_dec(ctx, program, (GLuint)i, (GLsizei)(uMax + 4), &len, &size,
+                                    &type, name);
+        GLint loc = len > 0 ? ctx->glGetUniformLocation_dec(ctx, program, name) : -1;
+        uint32_t f[4] = {(uint32_t)len, (uint32_t)size, (uint32_t)type, (uint32_t)loc};
+        memcpy(rec, f, sizeof(f));
+    }
+    for (GLint i = 0; i < nA; i++, rec += aRec) {
+        GLsizei len = 0;
+        GLint size = 0;
+        GLenum type = 0;
+        GLchar* name = (GLchar*)(rec + 16);
+        ctx->glGetActiveAttrib_dec(ctx, program, (GLuint)i, (GLsizei)(aMax + 4), &len, &size,
+                                   &type, name);
+        GLint loc = len > 0 ? ctx->glGetAttribLocation_dec(ctx, program, name) : -1;
+        uint32_t f[4] = {(uint32_t)len, (uint32_t)size, (uint32_t)type, (uint32_t)loc};
+        memcpy(rec, f, sizeof(f));
+    }
+}
