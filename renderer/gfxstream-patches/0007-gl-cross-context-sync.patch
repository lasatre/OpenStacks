@@ -1129,6 +1156,13 @@ void ColorBufferGl::setSync(bool debug) {
     if (debug) fprintf(stderr, "%s: %u to %p\n", __func__, getHndl(), m_sync);
 }
 
+void ColorBufferGl::setSyncFromCurrentContext() {
+    RenderThreadInfoGl* const tInfo = RenderThreadInfoGl::get();
+    if (m_eglImage && tInfo && tInfo->currContext.get()) {
+        setSync();
+    }
+}
