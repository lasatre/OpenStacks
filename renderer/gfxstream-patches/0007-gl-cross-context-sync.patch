         s_gles2.glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, m_eglImage);
     } else {
@@ -1089,6 +1112,8 @@ bool ColorBufferGl::bindToTexture2() {
         return false;
     }
 
+    waitSync();                          // OpenStacks: see bindToTexture
