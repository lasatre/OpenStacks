+
+// OpenStacks (issue #6): BlueStacks' Android 9 guest presents a frame with
+// rcFlushWindowColorBufferAsync. The command has no reply, so the guest does not wait
+// for it. The guest also has no native fences. So once the app queues the buffer,
+// SurfaceFlinger can bind it (rcBindTexture, on its own connection, i.e. its own host
+// thread) before the app's connection has delivered or executed the flush. It then
+// composites the buffer's previous contents: frames that jump back to an older state,
+// sprites missing.
+// AOSP's EGL avoids this by using the synchronous flush when it has no native sync ("an
+// old frame can be processed by surfaceflinger, resulting in out of order frames",
+// b/34396294); this guest does not.
+// So the host keeps the order: a buffer set as a window surface's target has a pending
+// write until that surface's next flush, and binding or posting it from another thread
+// waits for that flush. The wait is bounded, so a surface that never flushes stalls
+// nothing for long. OST_FLUSH_ORDER=0 turns it off.
+static bool ostFlushOrder() {
+    static const bool on = [] {
+        const char* v = getenv("OST_FLUSH_ORDER");
+        return !(v && *v == '0');
+    }();
+    return on;
+}
+
+void FrameBuffer::Impl::ostMarkWrite(HandleType surface, HandleType cb) {
+    if (!ostFlushOrder()) return;
+    std::lock_guard<std::mutex> lock(m_ostWriteLock);
+    auto prev = m_ostSurfaceTarget.find(surface);
+    if (prev != m_ostSurfaceTarget.end() && prev->second != cb) {
+        auto it = m_ostPendingWrites.find(prev->second);
+        if (it != m_ostPendingWrites.end() && it->second.surface == surface) {
+            m_ostPendingWrites.erase(it);        // retargeted without a flush: no frame came
+        }
+    }
+    m_ostSurfaceTarget[surface] = cb;
+    m_ostPendingWrites[cb] = {surface, std::this_thread::get_id()};
+    m_ostWriteCv.notify_all();
+}
+
+void FrameBuffer::Impl::ostWriteDone(HandleType surface) {
+    if (!ostFlushOrder()) return;
+    std::lock_guard<std::mutex> lock(m_ostWriteLock);
+    auto t = m_ostSurfaceTarget.find(surface);
+    if (t == m_ostSurfaceTarget.end()) return;
+    auto it = m_ostPendingWrites.find(t->second);
+    if (it != m_ostPendingWrites.end() && it->second.surface == surface) {
+        m_ostPendingWrites.erase(it);
+        m_ostWriteCv.notify_all();
+    }
+}
+
+void FrameBuffer::Impl::ostWaitWritten(HandleType cb) {
+    if (!ostFlushOrder()) return;
+    std::unique_lock<std::mutex> lock(m_ostWriteLock);
+    auto it = m_ostPendingWrites.find(cb);
+    if (it == m_ostPendingWrites.end() || it->second.writer == std::this_thread::get_id()) {
+        return;
+    }
+    const HandleType surface = it->second.surface;
+    const bool done = m_ostWriteCv.wait_for(lock, std::chrono::milliseconds(100), [&] {
+        auto i = m_ostPendingWrites.find(cb);
+        return i == m_ostPendingWrites.end() || i->second.surface != surface;
+    });
+    if (!done) {
+        // the writer never flushed (an abandoned frame): later reads must not wait too
+        auto i = m_ostPendingWrites.find(cb);
+        if (i != m_ostPendingWrites.end() && i->second.surface == surface) {
+            m_ostPendingWrites.erase(i);
+        }
+        static std::atomic<int> logged{0};
+        if (logged++ < 5) {
+            GFXSTREAM_WARNING("flush order: colour buffer %u read before surface %u flushed "
+                              "(gave up after 100 ms)", cb, surface);
+        }
+    }
 }
 
