+// ---- OpenStacks image detection (common/imgd.h, docs/re/kmm_controls.md 3.20) -------------
+// HD-Player's Imgd.cpp, run inside the translator: texture uploads record a CRC32 per
+// texture, draws test the configured images. Nothing here touches the guest's GL state or
+// error flag: uniforms and buffers are read through ProgramData / the host dispatcher.
+
+static GLESbuffer* s_imgdBuffer(GLEScontext* ctx, GLuint name) {
+    if (!name) return nullptr;
+    auto obj = ctx->shareGroup()->getObjectData(NamedObjectType::VERTEXBUFFER, name);
+    return obj ? static_cast<GLESbuffer*>(obj) : nullptr;
+}
+
+static imgd::Attr s_imgdAttr(GLESv2Context* ctx, int index) {
+    imgd::Attr a;
+    const GLESpointer* p = index >= 0 ? ctx->getPointer((GLenum)index) : nullptr;
+    if (!p || !p->isEnable()) return a;
+    if (p->getAttribType() == GLESpointer::BUFFER) {
+        GLESbuffer* b = s_imgdBuffer(ctx, p->getBufferName());
+        if (!b || !b->getData() || p->getBufferOffset() > b->getSize()) return a;
+        a.data = static_cast<const uint8_t*>(b->getData()) + p->getBufferOffset();
+        a.avail = b->getSize() - p->getBufferOffset();
+    } else if (p->getAttribType() == GLESpointer::ARRAY) {
+        a.data = static_cast<const uint8_t*>(p->getArrayData());
+        a.avail = p->getDataSize() > 0 ? (size_t)p->getDataSize() : 0;
+    } else {
+        return a;
+    }
+    a.size = p->getSize();
+    a.type = p->getType();
+    a.normalized = p->isNormalize();
+    a.stride = p->getStride();
+    return a;
+}
+
+// 16 floats (4 vec4 columns) of uniform `name[0..3]`, or of a uniform block member
+static bool s_imgdMatrix(GLESv2Context* ctx, GLuint globalProg, ProgramData* pd,
+                         const char* name, float out[16]) {
+    for (int i = 0; i < 4; i++) {
+        char n[96];
+        snprintf(n, sizeof(n), "%s[%d]", name, i);
+        int loc = pd->getGuestUniformLocation(n);
+        if (loc < 0) return false;
+        ctx->dispatcher().glGetUniformfv(globalProg, pd->getHostUniformLocation(loc),
+                                         out + 4 * i);
+    }
+    return true;
+}
+
+static void s_imgdBlockFloats(GLESv2Context* ctx, GLuint globalProg, const char* block,
+                              int floatOff, float out[16]) {
+    memset(out, 0, 16 * sizeof(float));
+    if (ctx->getMajorVersion() < 3 || !ctx->dispatcher().glGetUniformBlockIndex ||
+        !ctx->dispatcher().glGetActiveUniformBlockiv || !ctx->dispatcher().glGetInteger64i_v)
+        return;
+    GLuint idx = ctx->dispatcher().glGetUniformBlockIndex(globalProg, block);
+    if (idx == GL_INVALID_INDEX) return;
+    GLint binding = -1;
+    ctx->dispatcher().glGetActiveUniformBlockiv(globalProg, idx, GL_UNIFORM_BLOCK_BINDING,
+                                                &binding);
+    if (binding < 0) return;
+    GLESbuffer* b = s_imgdBuffer(ctx, ctx->getIndexedBuffer(GL_UNIFORM_BUFFER, binding));
+    if (!b || !b->getData()) return;
+    GLint64 start = 0;
+    ctx->dispatcher().glGetInteger64i_v(GL_UNIFORM_BUFFER_START, binding, &start);
+    size_t off = (size_t)start + (size_t)floatOff * 4;
+    if (start < 0 || off + 64 > b->getSize()) return;
+    memcpy(out, static_cast<const uint8_t*>(b->getData()) + off, 64);
+}
+
+// imgdNormalizedScreenPositionGroupA (0x1402b8d60): unity_ObjectToWorld / unity_MatrixVP from
+// plain uniforms, else from the UnityPerDraw (float 0) / UnityPerFrame (float 76) blocks
+static void s_imgdUnityMatrices(GLESv2Context* ctx, GLuint globalProg, ProgramData* pd,
+                                float o2w[16], float vp[16]) {
+    if (s_imgdMatrix(ctx, globalProg, pd, "hlslcc_mtx4x4unity_ObjectToWorld", o2w) &&
+        s_imgdMatrix(ctx, globalProg, pd, "hlslcc_mtx4x4unity_MatrixVP", vp))
+        return;
+    s_imgdBlockFloats(ctx, globalProg, "UnityPerDraw", 0, o2w);
+    s_imgdBlockFloats(ctx, globalProg, "UnityPerFrame", 76, vp);
+}
+
+// imageDetect (0x1402b09d0) for one draw
+static void s_imgdDraw(GLESv2Context* ctx, GLenum mode, GLint first, GLsizei count,
+                       GLenum type, const GLvoid* indices, bool elements) {
+    if (!imgd::armed() || count < 3 || !ctx->shareGroup().get()) return;
+    std::shared_ptr<const imgd::Config> cfg = imgd::current();
+    GLuint prog = ctx->getCurrentProgram();
+    if (!cfg || !prog) return;
+    auto pobj = ctx->shareGroup()->getObjectData(NamedObjectType::SHADER_OR_PROGRAM, prog);
+    if (!pobj || pobj->getDataType() != PROGRAM_DATA) return;
+    ProgramData* pd = static_cast<ProgramData*>(pobj);
+    if (!pd->getLinkStatus()) return;
+    const GLuint globalProg =
+            ctx->shareGroup()->getGlobalName(NamedObjectType::SHADER_OR_PROGRAM, prog);
+    if (!globalProg) return;
+
+    // the texture unit of the game's sampler (FUN_1402b1400); unit 0 without one
+    int unit = 0;
+    if (!cfg->sampler.empty()) {
+        int loc = pd->getGuestUniformLocation(cfg->sampler.c_str());
+        if (loc < 0 && !cfg->sampler2.empty())
+            loc = pd->getGuestUniformLocation(cfg->sampler2.c_str());
+        if (loc >= 0) {
+            GLint u = 0;
+            ctx->dispatcher().glGetUniformiv(globalProg, pd->getHostUniformLocation(loc), &u);
+            unit = u;
+        }
+    }
+    if (unit < 0 || unit >= ctx->getMaxCombinedTexUnits()) return;
+    unsigned int tex = ctx->getBindedTexture(GL_TEXTURE0 + unit, GL_TEXTURE_2D);
+    auto tobj = ctx->shareGroup()->getObjectData(
+            NamedObjectType::TEXTURE, ctx->getTextureLocalName(GL_TEXTURE_2D, tex));
+    if (!tobj || tobj->getDataType() != TEXTURE_DATA) return;
+    const uint32_t crc = static_cast<TextureData*>(tobj)->imgdCrc;
+    if (!crc) return;
+    auto range = cfg->byCrc.equal_range(crc);
+    if (range.first == range.second) return;
+
+    imgd::Order ord;
+    ord.mode = mode;
+    ord.count = count;
+    ord.first = first;
+    if (elements) {
+        ord.type = type;
+        size_t esz = type == GL_UNSIGNED_BYTE ? 1 : type == GL_UNSIGNED_SHORT ? 2 : 4;
+        if (ctx->isBindedBuffer(GL_ELEMENT_ARRAY_BUFFER)) {
+            GLESbuffer* b = s_imgdBuffer(ctx, ctx->getBuffer(GL_ELEMENT_ARRAY_BUFFER));
+            uintptr_t off = (uintptr_t)indices;
+            if (!b || !b->getData() || off > b->getSize()) return;
+            ord.data = static_cast<const uint8_t*>(b->getData()) + off;
+            ord.avail = b->getSize() - off;
+        } else {
+            if (!indices) return;
+            ord.data = static_cast<const uint8_t*>(indices);
+            ord.avail = (size_t)count * esz;
+        }
+    }
+
+    bool haveMats = false;
+    float o2w[16], vp[16];
+    for (auto it = range.first; it != range.second; ++it) {
+        const int idx = it->second;
+        if (imgd::isFound(idx)) continue;
+        const imgd::Image& im = cfg->images[idx];
+        imgd::Attr texAttr = s_imgdAttr(ctx, im.texAttr);
+        if (imgd::logLevel() >= 1)
+            imgd::logOnce(crc, "drawn (unit %d, mode 0x%x, %s, attr %d: %s type 0x%x size %d)",
+                          unit, mode, elements ? "elements" : "arrays", im.texAttr,
+                          texAttr.data ? "data" : "NO DATA", texAttr.type, texAttr.size);
+        if (!texAttr.data) continue;
+        const bool useRect = im.hasRect && cfg->emu == imgd::EMU_UNITY;
+        imgd::Attr posAttr;
+        if (useRect) posAttr = s_imgdAttr(ctx, im.posAttr);
+        int cursor = 0, tri[3];
+        while (imgd::findTriangle(texAttr, ord, im.u, im.v, &cursor, tri)) {
+            if (!useRect) {
+                imgd::markFound(idx);
+                break;
+            }
+            float p[4], c[4], x, y;
+            if (!imgd::centroid(posAttr, ord, tri, p)) break;
+            if (!haveMats) {
+                s_imgdUnityMatrices(ctx, globalProg, pd, o2w, vp);
+                haveMats = true;
+            }
+            imgd::unityClip(o2w, vp, p, c);
+            imgd::clipToPercent(c, &x, &y);
+            if (imgd::inRect(im.rect, x, y)) {
+                imgd::markFound(idx);
+                break;
+            }
+        }
+    }
+}
