+// OpenStacks image detection: texture CRCs (common/imgd.h; the draw side is s_imgdDraw)
+static thread_local bool t_imgdInCompressed = false;   // the decompressing glTexImage2D call
+
+static void s_imgdSetCrc(GLEScontext* ctx, GLenum target, GLint level, uint32_t crc,
+                         const char* how = "", unsigned w = 0, unsigned h = 0, unsigned fmt = 0,
+                         unsigned type = 0) {
+    if (imgd::logLevel() >= 3)
+        imgd::logOnce(crc, "%s %ux%u fmt 0x%x type 0x%x level %d target 0x%x (any)", how, w, h,
+                      fmt, type, level, target);
+    if (target != GL_TEXTURE_2D || level != 0 || !ctx->shareGroup().get()) return;
+    TextureData* texData = getTextureTargetData(target);
+    if (texData) texData->imgdCrc = crc;
+    if (crc && imgd::logLevel() >= 1) {
+        auto cfg = imgd::current();
+        bool wanted = cfg && cfg->byCrc.count(crc);
+        if (wanted || imgd::logLevel() >= 2)
+            imgd::logOnce(crc, "%s %ux%u fmt 0x%x type 0x%x level %d target 0x%x%s", how, w, h,
+                          fmt, type, level, target, wanted ? " (an image's texture)" : "");
+    }
+}
+
+static uint32_t s_imgdPixelsCrc(GLEScontext* ctx, GLsizei w, GLsizei h, GLenum format,
+                                GLenum type, const GLvoid* pixels) {
+    if (!pixels || w <= 0 || h <= 0 || ctx->isBindedBuffer(GL_PIXEL_UNPACK_BUFFER)) return 0;
+    int ps = imgd::pixelSize(format, type);
+    return ps > 0 ? imgd::crc32(pixels, (size_t)ps * (size_t)w * (size_t)h) : 0;
+}
